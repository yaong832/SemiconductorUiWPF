<Window x:Class="SemiconductorUi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
        xmlns:views="clr-namespace:SemiconductorUi.Wpf.Views"
        xmlns:conv="clr-namespace:SemiconductorUi.Wpf.Infrastructure"
        xmlns:ctl="clr-namespace:SemiconductorUi.Wpf.Controls"
        Title="웨이퍼 이송 장비 - SemiconductorUi" Width="1600" Height="940" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBack}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:EnumEqualsConverter x:Key="EnumVisible" ToVisibility="True"/>
    </Window.Resources>

    <!-- SEMI E95 배치 (원본 Form1.Shell): 맨 위 타이틀 줄 / 본문(작은 탭 + 내용) / 맨 아래 메뉴 줄 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 줄 (원본 Controls/ShellTopBar) -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 장비 이름 + 지금 보는 화면 -->
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Primary}" Margin="20,0,10,0">
                        <Grid>
                            <Ellipse Width="14" Height="14" Stroke="White" StrokeThickness="1.8"/>
                            <Rectangle Width="8" Height="1.4" Fill="#96FFFFFF"/>
                            <Rectangle Width="1.4" Height="8" Fill="#96FFFFFF"/>
                        </Grid>
                    </Border>
                    <StackPanel Width="176" VerticalAlignment="Center">
                        <TextBlock Text="웨이퍼 이송 장비" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding ViewTitle}" FontSize="11" Foreground="{StaticResource Primary}" Margin="1,2,0,0"/>
                    </StackPanel>
                    <Rectangle Width="1" Height="27" Fill="{StaticResource Border}"/>

                    <!-- 큰 상태 표시 (가장 긴 글자 자리를 잡아 두어 옆 로그인 줄이 움직이지 않음) -->
                    <Grid Margin="18,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="공정 진행 중" FontSize="14.5" FontWeight="Bold" Margin="32,0,14,0" Visibility="Hidden"/>
                        <Border CornerRadius="17" Height="34" Background="{Binding StatePillBackground}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="15,0,14,0" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding StatePillDot}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding StatePillText}" Foreground="{Binding StatePillForeground}" FontSize="14.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Rectangle Width="1" Height="27" Fill="{StaticResource Border}" Margin="0,0,7,0"/>

                    <!-- 로그인 사용자 + 로그인/로그아웃/사용자 관리 (SEMI E95: 타이틀 줄에 로그인) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="92">
                        <Grid Width="30" Height="30" Margin="1,0,8,0">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SurfaceAlt}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.IsLoggedIn}" Value="True">
                                                <Setter Property="Fill" Value="#E8EFFA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding UserInitial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Width="53">
                            <TextBlock Text="{Binding LoginStatusText}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding RoleText}" FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="로그인" Style="{StaticResource BarButton}" Width="64" Margin="6,0,0,0" Command="{Binding LoginCommand}"/>
                    <Button Content="로그아웃" Style="{StaticResource BarButton}" Width="76" Margin="4,0,0,0" Command="{Binding LogoutCommand}"/>
                    <Button Content="사용자 관리" Style="{StaticResource BarButton}" Width="92" Margin="4,0,0,0" Command="{Binding UserManagementCommand}"/>
                </StackPanel>

                <!-- 오른쪽: 연결 · 서보 · 알람 · 시계 · 3색 램프 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding EthercatStatusBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding EthercatStatusText}" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="연결" Style="{StaticResource BarButton}" Width="52" Margin="6,0,0,0" Command="{Binding ConnectEthercatCommand}"/>
                    <Button Content="해제" Style="{StaticResource BarButton}" Width="52" Margin="4,0,0,0" Command="{Binding DisconnectEthercatCommand}"/>
                    <Rectangle Width="1" Height="27" Fill="{StaticResource Border}" Margin="12,0,0,0"/>

                    <Border Style="{StaticResource Chip}" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ServoStatusBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ServoStatusText}" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="서보 ON" Style="{StaticResource BarButton}" Width="68" Margin="6,0,0,0" Command="{Binding ServoOnCommand}"/>
                    <Button Content="서보 OFF" Style="{StaticResource BarButton}" Width="72" Margin="4,0,0,0" Command="{Binding ServoOffCommand}"/>
                    <Rectangle Width="1" Height="27" Fill="{StaticResource Border}" Margin="12,0,0,0"/>

                    <!-- 원본 8baff6e: 알람 표시를 누르면 현재 알람과 알람 이력 창 -->
                    <Button Margin="12,0,0,0" MaxWidth="290" Cursor="Hand" Command="{Binding ShowAlarmHistoryCommand}"
                            ToolTip="{Binding AlarmChipToolTip}" VerticalAlignment="Center" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="chip" Style="{StaticResource Chip}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Danger}" CornerRadius="8" MinWidth="18" Height="16"
                                    Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasActiveAlarms, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ActiveAlarmCount}" Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Ellipse Width="8" Height="8" Fill="{Binding AlarmBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AlarmText}" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Button>
                    <TextBlock Text="{Binding ClockText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                               Margin="14,0,0,0" FontWeight="SemiBold"/>
                    <ctl:TowerLamp Scene="{Binding Monitoring.Scene}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 (원본 tableShellContent: Padding 10,0,6,6) -->
        <Grid Grid.Row="1" Margin="10,0,6,6">
            <!-- 운전 화면: 작은 탭 + 탭 내용 -->
            <Grid Visibility="{Binding IsOperatePage, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton Style="{StaticResource SubTab}" Content="모니터링"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OperateTab.Monitoring}}"/>
                    <RadioButton Style="{StaticResource SubTab}" Content="검증"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OperateTab.Verification}}"/>
                    <RadioButton Style="{StaticResource SubTab}" Content="이송"
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OperateTab.Transfer}}"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="0,6,6,6">
                    <Grid>
                        <views:MonitoringView DataContext="{Binding Monitoring}"
                                              Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisible}, ConverterParameter={x:Static vm:OperateTab.Monitoring}}"/>
                        <views:PlaceholderView Title="검증"
                                               Visibility="{Binding CurrentTab, Converter={StaticResource EnumVisible}, ConverterParameter={x:Static vm:OperateTab.Verification}}"/>
                        <views:PlaceholderView Title="이송"
                                               Visibility="{Binding CurrentTab, Converter={StaticResource EnumVisible}, ConverterParameter={x:Static vm:OperateTab.Transfer}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 그 밖의 메뉴: 이후 단계에서 화면 이관 -->
            <Grid Margin="0,10,0,0" Visibility="{Binding IsTrendPage, Converter={StaticResource BoolToVisibility}}">
                <views:TrendView DataContext="{Binding Trend}"/>
            </Grid>
            <views:PlaceholderView Margin="0,10,0,0" Title="{Binding CurrentPageTitle}"
                                   Visibility="{Binding IsPlaceholderPage, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- 맨 아래 메뉴 줄 (원본 BuildShellBottomBar): 화면 메뉴 / 현재 상태 / 시스템 -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavBarItem}" Content="운전" Tag="&#xE768;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Operate}}"/>
                    <RadioButton Style="{StaticResource NavBarItem}" Content="레시피" Tag="&#xE8A5;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Recipe}}"/>
                    <RadioButton Style="{StaticResource NavBarItem}" Content="유지보수" Tag="&#xE90F;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Maintenance}}"/>
                    <RadioButton Style="{StaticResource NavBarItem}" Content="설정" Tag="&#xE713;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Config}}"/>
                    <RadioButton Style="{StaticResource NavBarItem}" Content="추이" Tag="&#xE9D2;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Trend}}"/>
                    <RadioButton Style="{StaticResource NavBarItem}" Content="보고서" Tag="&#xE9F9;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Report}}"/>
                </StackPanel>

                <!-- 현재 상태 한 줄 (원본 ShellStatusLine) -->
                <Border Grid.Column="1" Margin="10,0" CornerRadius="8" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="현재 상태" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding StatusLineText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <RadioButton Grid.Column="2" Style="{StaticResource NavBarItem}" Margin="0" Content="시스템" Tag="&#xE770;"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.System}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
