<Window x:Class="SemiconductorUi.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
        xmlns:views="clr-namespace:SemiconductorUi.Wpf.Views"
        xmlns:conv="clr-namespace:SemiconductorUi.Wpf.Infrastructure"
        Title="Semiconductor UI" Width="1600" Height="940" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBack}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:EnumEqualsConverter x:Key="EnumVisible" ToVisibility="True"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 바 (원본 Controls/ShellTopBar) -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Semiconductor UI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Margin="16,0,0,0" CornerRadius="12" Padding="10,3" Background="{Binding StatePillBackground}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatePillDot}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding StatePillText}" Foreground="{Binding StatePillForeground}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" Text="{Binding ClockText}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>

                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="12,0,0,0" MaxWidth="360">
                    <TextBlock Text="{Binding AlarmText}" Foreground="{Binding AlarmBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding AlarmText}"/>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Style="{StaticResource Chip}">
                        <TextBlock Text="{Binding ServoStatusText}" Foreground="{Binding ServoStatusBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="서보 ON" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ServoOnCommand}"/>
                    <Button Content="서보 OFF" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Command="{Binding ServoOffCommand}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}">
                        <TextBlock Text="{Binding EthercatStatusText}" Foreground="{Binding EthercatStatusBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="연결" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ConnectEthercatCommand}"/>
                    <Button Content="해제" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Command="{Binding DisconnectEthercatCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 세로 메뉴 (원본 ShellNavPainter) -->
            <Border Grid.Column="0" Background="#1E2836">
                <DockPanel>
                    <!-- 사용자 카드 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="6,6,6,10">
                        <TextBlock Text="{Binding LoginStatusText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RoleText}" Foreground="#9AA7B8" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                        <Button Content="로그인" Style="{StaticResource PrimaryButton}" Padding="4,5" Margin="0,2" Command="{Binding LoginCommand}"/>
                        <Button Content="로그아웃" Style="{StaticResource SecondaryButton}" Padding="4,5" Margin="0,2" Command="{Binding LogoutCommand}"/>
                        <Button Content="사용자 관리" Style="{StaticResource SecondaryButton}" Padding="4,5" Margin="0,2" FontSize="11" Command="{Binding UserManagementCommand}"/>
                    </StackPanel>
                    <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Content="시스템" Tag="&#xE770;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.System}}"/>
                    <StackPanel Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource NavItem}" Content="운전" Tag="&#xE768;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Operate}}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="레시피" Tag="&#xE8A5;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Recipe}}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="유지보수" Tag="&#xE90F;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Maintenance}}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="설정" Tag="&#xE713;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Config}}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="추이" Tag="&#xE9D2;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Trend}}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="보고서" Tag="&#xE9F9;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:NavPage.Report}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 본문 -->
            <Grid Grid.Column="1" Margin="6,0,4,4">
                <!-- 운전 화면: 작은 탭 + 탭 내용 -->
                <Grid Visibility="{Binding IsOperatePage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton Style="{StaticResource SubTab}" Content="모니터링"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OperateTab.Monitoring}}"/>
                        <RadioButton Style="{StaticResource SubTab}" Content="검증"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OperateTab.Verification}}"/>
                        <RadioButton Style="{StaticResource SubTab}" Content="이송"
                                     IsChecked="{Binding CurrentTab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:OperateTab.Transfer}}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="0,6,6,6">
                        <Grid>
                            <views:MonitoringView DataContext="{Binding Monitoring}"
                                                  Visibility="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumVisible}, ConverterParameter={x:Static vm:OperateTab.Monitoring}}"/>
                            <views:PlaceholderView Title="검증"
                                                   Visibility="{Binding CurrentTab, Converter={StaticResource EnumVisible}, ConverterParameter={x:Static vm:OperateTab.Verification}}"/>
                            <views:PlaceholderView Title="이송"
                                                   Visibility="{Binding CurrentTab, Converter={StaticResource EnumVisible}, ConverterParameter={x:Static vm:OperateTab.Transfer}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 그 밖의 메뉴: 4단계에서 화면 이관 -->
                <views:PlaceholderView Margin="0,10,0,0" Title="{Binding CurrentPageTitle}"
                                       Visibility="{Binding IsOperatePage, Converter={StaticResource EnumVisible}, ConverterParameter=False}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
