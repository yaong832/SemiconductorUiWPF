<Window x:Class="SemiconductorUi.Wpf.Views.AlarmHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알람" Width="1000" Height="640" MinWidth="680" MinHeight="440" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.AlarmHistoryForm: 현재 알람 + 날짜별 알람 이력. 모달이 아니며 보기 전용 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="RowBackground" Value="{StaticResource Surface}"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="96"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 현재 알람 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActive}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ActiveTitle}" FontSize="15" FontWeight="Bold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" MaxHeight="190">
            <Grid>
                <DataGrid x:Name="ActiveGrid" Style="{StaticResource ListGrid}" ItemsSource="{Binding Active}" Foreground="{StaticResource Danger}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="64"/>
                        <DataGridTextColumn Header="유닛" Binding="{Binding Unit}" Width="90"/>
                        <DataGridTextColumn Header="알람" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/>
                        <DataGridTextColumn Header="발생 시각" Binding="{Binding SetTimeText}" Width="110"/>
                        <DataGridTextColumn Header="경과" Binding="{Binding Elapsed}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="걸려 있는 알람이 없습니다." Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 알람 이력: 날짜, 필터, 도구 -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="180" Height="32" VerticalContentAlignment="Center" Padding="6,0"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="코드, 유닛, 알람, 상세, 사용자에서 찾기"/>
                <CheckBox Content="발생만" IsChecked="{Binding OnlySet}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <Button Content="새로고침" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"/>
                <Button Content="폴더 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="알람 이력" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="◀" Style="{StaticResource ToolButton}" Margin="0" Command="{Binding PreviousDayCommand}" ToolTip="전날"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="130" Height="32" Margin="6,0,0,0"
                            VerticalContentAlignment="Center" SelectedDateFormat="Short"/>
                <Button Content="▶" Style="{StaticResource ToolButton}" Command="{Binding NextDayCommand}" ToolTip="다음 날"/>
                <Button Content="오늘" Style="{StaticResource ToolButton}" Command="{Binding TodayCommand}"/>
                <TextBlock Text="{Binding HistoryInfo}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <DataGrid Style="{StaticResource ListGrid}" ItemsSource="{Binding History}"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSet}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시각" Binding="{Binding Time}" Width="100"/>
                        <DataGridTextColumn Header="구분" Binding="{Binding Event}" Width="54"/>
                        <DataGridTextColumn Header="코드" Binding="{Binding Code}" Width="60"/>
                        <DataGridTextColumn Header="유닛" Binding="{Binding Unit}" Width="90"/>
                        <DataGridTextColumn Header="알람" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="상세" Binding="{Binding Detail}" Width="*"/>
                        <DataGridTextColumn Header="해제한 사용자" Binding="{Binding User}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding EmptyHistoryText}" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0"
                           Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="닫기" Style="{StaticResource SecondaryButton}" Width="96" Height="36"
                    FontWeight="Bold" Command="{Binding CloseCommand}"/>
            <TextBlock Text="알람 해제는 메인 화면의 [알람 리셋]으로 합니다. 이 창은 보기 전용입니다."
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
