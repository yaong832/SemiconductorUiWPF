<UserControl x:Class="SemiconductorUi.Wpf.Views.ChangeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.ChangeHistoryForm: 누가 언제 무엇을 바꿨는지 (읽기 전용) -->
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RightHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ListHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Row" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="0,6,6,6" Padding="16,12,16,16">
        <DockPanel>
            <!-- 도구 줄: 기간, 구분, 검색 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로고침" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"/>
                    <Button Content="폴더 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="120" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding Periods}"
                              SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Name"/>
                    <TextBlock Text="구분" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox Width="130" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"/>
                    <!-- 검색 (WPF 추가) -->
                    <Grid Width="260" Height="34" Margin="16,0,0,0">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 VerticalContentAlignment="Center" Padding="8,0,28,0" BorderBrush="{StaticResource Border}"/>
                        <TextBlock Text="사용자·대상·항목·값 검색" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕" HorizontalAlignment="Right" Width="26" Margin="0,4,4,4" FontSize="11" Padding="0"
                                Style="{StaticResource FlatButton}" Command="{Binding ClearSearchCommand}" ToolTip="검색 지우기"/>
                    </Grid>
                    <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Footnote}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ListView ItemsSource="{Binding Rows}" BorderThickness="0" Background="{StaticResource Surface}" FontSize="12.5"
                              SelectionMode="Single" ItemContainerStyle="{StaticResource Row}"
                              VirtualizingPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                                <GridViewColumn Header="시각" DisplayMemberBinding="{Binding TimeText}" Width="150"/>
                                <GridViewColumn Header="사용자" DisplayMemberBinding="{Binding UserText}" Width="140"/>
                                <GridViewColumn Header="구분" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#E8EFFA">
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="대상" DisplayMemberBinding="{Binding Target}" Width="220"/>
                                <GridViewColumn Header="항목" DisplayMemberBinding="{Binding Item}" Width="240"/>
                                <GridViewColumn Header="이전 값" Width="170" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Before}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Before}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="바뀐 값" Width="170" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding After}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding After}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="이 기간에 바뀐 값이 없습니다." Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
