<Window x:Class="SemiconductorUi.Wpf.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="800" Height="560" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.ConfigForm: 환경 알람 기준 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <DataTemplate x:Key="GroupTemplate">
            <Border Margin="0,0,0,12" Padding="14,10,14,10" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Input" Grid.Column="1" Height="26" HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center" BorderBrush="{StaticResource Border}"
                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter TargetName="Input" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                        <Setter TargetName="Input" Property="Background" Value="#FBE9EA"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 버튼: 왼쪽 티칭 위치, 오른쪽 기본값 복원 / 취소 / 저장 -->
        <Border DockPanel.Dock="Bottom" Height="68" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="TM 티칭 위치" Style="{StaticResource ActionButton}" Width="140"
                        Command="{Binding TeachingCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="기본값 복원" Style="{StaticResource ActionButton}" Width="130" Margin="0,0,10,0" Command="{Binding ResetCommand}"/>
                    <Button Content="취소" Style="{StaticResource ActionButton}" Width="100" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                    <Button Content="저장" Style="{StaticResource PrimaryButton}" Width="120" Height="44" FontWeight="Bold" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="20,16,20,0">
            <TextBlock Text="알람 기준" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="현재값(PV)이 설정값(SV)에서 이만큼 벗어나면 경고 또는 알람을 띄웁니다." Margin="0,4,0,12"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <!-- 윗줄: 온도 | RF, 아랫줄: 압력 | 가스 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <ContentPresenter Grid.Row="0" Grid.Column="0" Content="{Binding Temp}" ContentTemplate="{StaticResource GroupTemplate}"/>
                <ContentPresenter Grid.Row="0" Grid.Column="2" Content="{Binding Rf}" ContentTemplate="{StaticResource GroupTemplate}"/>
                <ContentPresenter Grid.Row="1" Grid.Column="0" Content="{Binding Press}" ContentTemplate="{StaticResource GroupTemplate}"/>
                <ContentPresenter Grid.Row="1" Grid.Column="2" Content="{Binding Gas}" ContentTemplate="{StaticResource GroupTemplate}"/>
            </Grid>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                       Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </DockPanel>
</Window>
