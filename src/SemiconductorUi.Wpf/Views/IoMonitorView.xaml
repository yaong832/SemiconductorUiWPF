<UserControl x:Class="SemiconductorUi.Wpf.Views.IoMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
             FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.IoMonitorForm: 디지털 입력/출력 16점씩 + 서보 두 축. 읽기 전용 -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="DotOff" Color="#C8CED6"/>
        <SolidColorBrush x:Key="ChangedBack" Color="#FFF4D6"/>
        <DataTemplate x:Key="PointRow" DataType="{x:Type vm:IoPointRow}">
            <Border x:Name="row" Height="24" Padding="10,0" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding IndexText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="dot" Width="11" Height="11" Fill="{StaticResource DotOff}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="state" Text="{Binding StateText}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnused}" Value="True">
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource TextSecondary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}"/>
                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecentlyChanged}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource ChangedBack}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,8,10,6"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상태 줄 -->
        <DockPanel Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Right" Content="미사용 입력 숨기기" IsChecked="{Binding HideUnused}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:IoMonitorTone.Ok}">
                                    <Setter Property="Fill" Value="{StaticResource Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:IoMonitorTone.Danger}">
                                    <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:IoMonitorTone.Ok}">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:IoMonitorTone.Danger}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- 입력 / 출력 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="디지털 입력 (센서)" Style="{StaticResource PanelTitle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource PointRow}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="디지털 출력 (마지막으로 보낸 값)" Style="{StaticResource PanelTitle}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource PointRow}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 서보 상태 -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="서보 상태 (드라이브 상태워드)" Style="{StaticResource PanelTitle}"/>
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="축" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="상태워드" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Grid.Column="2" Text="상태" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Grid.Column="3" Text="주요 비트" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Grid.Column="4" Text="엔코더 위치" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Axes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServoAxisRow}">
                            <Grid Margin="10,6,10,0" Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*" MinWidth="340"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding StatusWordText}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock x:Name="state" Grid.Column="2" Text="{Binding StateName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ItemsControl Grid.Column="3" ItemsSource="{Binding Bits}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ServoBitItem}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                <Ellipse x:Name="dot" Width="10" Height="10" Fill="{StaticResource DotOff}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="{Binding Name}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:IoMonitorTone.Ok}">
                                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Success}"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:IoMonitorTone.Danger}">
                                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource Danger}"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="4" Text="{Binding Position}" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFault}" Value="True">
                                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding Footnote}" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
