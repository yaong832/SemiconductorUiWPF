<Window x:Class="SemiconductorUi.Wpf.Views.IoMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SemiconductorUi.Wpf.Views"
        Title="I/O 모니터 (읽기 전용)" Width="900" Height="680" MinWidth="720" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource AppBack}"
        FontFamily="{StaticResource UiFont}">
    <!-- 원본 Forms.IoMonitorForm. 모달이 아니며, 닫으면 숨겨 두었다가 다시 쓴다 -->
    <Border Background="{StaticResource Surface}" Margin="10" CornerRadius="6" Padding="14,12">
        <views:IoMonitorView/>
    </Border>
</Window>
