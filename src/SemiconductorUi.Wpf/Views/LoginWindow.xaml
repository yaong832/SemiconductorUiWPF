<Window x:Class="SemiconductorUi.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="로그인" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">
    <StackPanel Margin="24">
        <TextBlock Text="로그인 정보를 입력" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
        <TextBlock Text="사용자명" Foreground="{StaticResource TextSecondary}"/>
        <TextBox x:Name="UsernameBox" Margin="0,4,0,12" Padding="6,4"/>
        <TextBlock Text="비밀번호" Foreground="{StaticResource TextSecondary}"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,8" Padding="6,4"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,0,0,12" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="확인" Style="{StaticResource PrimaryButton}" Width="80" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
