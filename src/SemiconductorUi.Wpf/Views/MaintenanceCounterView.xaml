<UserControl x:Class="SemiconductorUi.Wpf.Views.MaintenanceCounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
             xmlns:svc="clr-namespace:SemiconductorUi.Services;assembly=SemiconductorUi.Core"
             FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.MaintenanceCounterForm: 동작 횟수, 점검 주기, 점검 이력 (유지보수 화면 탭과 별도 창이 같이 쓴다) -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="DueRowBack" Color="#FDECED"/>
        <SolidColorBrush x:Key="SoonRowBack" Color="#FEF5E4"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RightHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ListHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="List" TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style x:Key="Row" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CounterRow" TargetType="ListViewItem" BasedOn="{StaticResource Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MaintenanceCounterStatus.Due}">
                    <Setter Property="Background" Value="{StaticResource DueRowBack}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MaintenanceCounterStatus.Soon}">
                    <Setter Property="Background" Value="{StaticResource SoonRowBack}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryRow" TargetType="ListViewItem" BasedOn="{StaticResource Row}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDue}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 카운터가 시작되지 않았을 때 (시뮬레이션 전용 장비 등) -->
        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="16">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding UnavailableText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="90"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>

            <!-- 항목별 횟수 -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <ListView Style="{StaticResource List}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                          ItemContainerStyle="{StaticResource CounterRow}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                            <GridViewColumn Header="항목" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="점검 후 횟수" Width="105" HeaderContainerStyle="{StaticResource RightHeader}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SinceServiceText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="점검 주기" Width="105" HeaderContainerStyle="{StaticResource RightHeader}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LimitText}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="상태" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:MaintenanceCounterRow}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock x:Name="text" Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                            <!-- 주기 대비 진행 막대 (WPF 추가) -->
                                            <Border x:Name="track" Height="4" Margin="0,2,0,0" CornerRadius="2" Background="#E4E8EE"
                                                    HorizontalAlignment="Left" Width="140">
                                                <Border x:Name="fill" CornerRadius="2" Background="{StaticResource Success}">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Ratio}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MaintenanceCounterStatus.Normal}">
                                                <Setter TargetName="text" Property="Foreground" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MaintenanceCounterStatus.Soon}">
                                                <Setter TargetName="text" Property="Foreground" Value="{StaticResource Warning}"/>
                                                <Setter TargetName="fill" Property="Background" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MaintenanceCounterStatus.Due}">
                                                <Setter TargetName="text" Property="Foreground" Value="{StaticResource Danger}"/>
                                                <Setter TargetName="fill" Property="Background" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MaintenanceCounterStatus.NoLimit}">
                                                <Setter TargetName="track" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="누적 횟수" Width="105" HeaderContainerStyle="{StaticResource RightHeader}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="마지막 점검" Width="175">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastServiceText}" Margin="8,0,0,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="세는 기준" Width="205">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- 선택한 항목: 점검 주기, 메모, 점검 완료 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" Height="30">
                <TextBlock Text="{Binding SelectedName}" Width="160" FontWeight="Bold" Style="{StaticResource Label}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="점검 주기" Style="{StaticResource Label}"/>
                <TextBox Width="120" Style="{StaticResource Field}" TextAlignment="Right" MaxLength="13"
                         Text="{Binding LimitInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}"/>
                <TextBlock Text="회 (0 = 없음)" Foreground="{StaticResource TextSecondary}" Style="{StaticResource Label}" Margin="6,0,8,0"/>
                <Button Content="주기 저장" Style="{StaticResource ToolButton}" Command="{Binding SaveLimitCommand}"
                        ToolTip="관리자만 바꿀 수 있습니다" Margin="0,0,20,0"/>
                <TextBlock Text="메모" Style="{StaticResource Label}"/>
                <TextBox Width="220" Style="{StaticResource Field}" MaxLength="200"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}"/>
                <Button Content="점검 완료" Style="{StaticResource PrimaryButton}" Height="30" MinWidth="92" Margin="8,0,0,0"
                        FontWeight="SemiBold" Command="{Binding AskServicedCommand}" ToolTip="로그인한 사용자만 기록할 수 있습니다"/>
            </StackPanel>

            <!-- 결과 메시지 또는 확인 질문 (창 안에서 묻는다) -->
            <Grid Grid.Row="3" Height="38" Margin="0,6,0,0">
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageTone}" Value="{x:Static vm:MaintenanceMessageTone.Success}">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MessageTone}" Value="{x:Static vm:MaintenanceMessageTone.Danger}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Background="{StaticResource SoonRowBack}" CornerRadius="4" Padding="10,4"
                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="확인" Style="{StaticResource PrimaryButton}" Height="28" MinWidth="80" Margin="4,0,0,0"
                                    Command="{Binding ConfirmServicedCommand}"/>
                            <Button Content="취소" Style="{StaticResource SecondaryButton}" Height="28" MinWidth="80" Margin="4,0,0,0"
                                    Command="{Binding CancelConfirmCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConfirmText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 점검 이력 -->
            <DockPanel Grid.Row="4" Margin="0,8,0,6">
                <Button DockPanel.Dock="Right" Content="폴더 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}"/>
                <TextBlock Text="{Binding HistoryTitle}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="5" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ListView Style="{StaticResource List}" ItemsSource="{Binding History}" ItemContainerStyle="{StaticResource HistoryRow}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                                <GridViewColumn Header="시각" DisplayMemberBinding="{Binding TimeText}" Width="150"/>
                                <GridViewColumn Header="구분" DisplayMemberBinding="{Binding Event}" Width="80"/>
                                <GridViewColumn Header="항목" DisplayMemberBinding="{Binding Item}" Width="140"/>
                                <GridViewColumn Header="횟수" Width="100" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="주기" Width="100" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LimitText}" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="사용자" DisplayMemberBinding="{Binding User}" Width="90"/>
                                <GridViewColumn Header="메모" DisplayMemberBinding="{Binding Note}" Width="330"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="아직 기록이 없습니다." Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <TextBlock Grid.Row="6" Text="{Binding Footnote}" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
