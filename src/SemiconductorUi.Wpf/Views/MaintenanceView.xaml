<UserControl x:Class="SemiconductorUi.Wpf.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SemiconductorUi.Wpf.Views"
             FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.MaintenanceForm. I/O 모니터를 화면 안에서 바로 보여 준다 -->
    <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="16,12,16,16">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="별도 창으로 열기" Style="{StaticResource SecondaryButton}"
                        Height="34" MinWidth="130" FontWeight="SemiBold" Command="{Binding OpenIoWindowCommand}"
                        ToolTip="다른 화면으로 옮겨도 계속 볼 수 있게 I/O 모니터를 따로 띄웁니다"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="I/O 모니터" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="디지털 입력·출력과 서보 상태를 읽기만 합니다. 장비에 아무 명령도 보내지 않습니다."
                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <views:IoMonitorView DataContext="{Binding Io}"/>
        </DockPanel>
    </Border>
</UserControl>
