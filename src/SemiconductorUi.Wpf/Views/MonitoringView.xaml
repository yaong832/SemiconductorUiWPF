<UserControl x:Class="SemiconductorUi.Wpf.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:SemiconductorUi.ViewModels;assembly=SemiconductorUi.Core">
    <UserControl.Resources>
        <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Stroke" Value="#40000000"/>
        </Style>
        <Style x:Key="LogLine" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- 장비 다이어그램 자리 (3단계에서 EquipmentDiagramControl/TmVisualization/FoupVisualization을 WPF로 다시 그림) -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="장비 현황" Style="{StaticResource CardTitle}"/>
                <Viewbox Stretch="Uniform" Margin="8">
                    <Canvas Width="760" Height="460">
                        <Canvas.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </Canvas.Resources>
                        <Border Canvas.Left="80" Canvas.Top="20" Width="180" Height="120"><TextBlock Text="Chamber A"/></Border>
                        <Border Canvas.Left="290" Canvas.Top="20" Width="180" Height="120"><TextBlock Text="Chamber B"/></Border>
                        <Border Canvas.Left="500" Canvas.Top="20" Width="180" Height="120"><TextBlock Text="Chamber C"/></Border>
                        <Border Canvas.Left="290" Canvas.Top="170" Width="180" Height="140" CornerRadius="70"><TextBlock Text="TM"/></Border>
                        <Border Canvas.Left="150" Canvas.Top="340" Width="160" Height="100"><TextBlock Text="FOUP A"/></Border>
                        <Border Canvas.Left="450" Canvas.Top="340" Width="160" Height="100"><TextBlock Text="FOUP B"/></Border>
                    </Canvas>
                </Viewbox>
            </DockPanel>
        </Border>

        <!-- 로그 -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="최근 메시지" Style="{StaticResource CardTitle}"/>
                <ListBox ItemsSource="{Binding Shell.Logs}" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextSecondary}" Width="64"/>
                                <TextBlock Text="{Binding Level}" Width="64" FontWeight="SemiBold" Style="{StaticResource LogLine}"/>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource LogLine}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 오른쪽 패널 -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 장비 상태 램프 (원본 Form1.LampPanel) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="장비 상태 램프" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                        <Setter Property="Fill" Value="#320F0C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.CurrentProcessState}" Value="{x:Static core:MainFormViewModel+ProcessState.Error}">
                                                <Setter Property="Fill" Value="#D23C32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                        <Setter Property="Fill" Value="#3C320F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.CurrentProcessState}" Value="{x:Static core:MainFormViewModel+ProcessState.Idle}">
                                                <Setter Property="Fill" Value="#E6BE28"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State.CurrentProcessState}" Value="{x:Static core:MainFormViewModel+ProcessState.Paused}">
                                                <Setter Property="Fill" Value="#E6BE28"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Lamp}">
                                        <Setter Property="Fill" Value="#143C1E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.CurrentProcessState}" Value="{x:Static core:MainFormViewModel+ProcessState.Running}">
                                                <Setter Property="Fill" Value="#37B45A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}">
                                <Run Text="경과"/> <Run Text="{Binding ElapsedText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 제어 패널 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="제어 패널" Style="{StaticResource CardTitle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="공정 시작" Style="{StaticResource PrimaryButton}" Margin="3" Height="40" Command="{Binding StartCommand}"/>
                            <Button Content="{Binding PauseText}" Style="{StaticResource PanelButton}" Command="{Binding PauseCommand}"/>
                            <Button Content="알람 리셋" Style="{StaticResource PanelButton}" Command="{Binding ResetAlarmCommand}"/>
                            <Button Content="공정 리셋" Style="{StaticResource PanelButton}" Command="{Binding ResetProcessCommand}"/>
                            <Button Content="장비 제어" Style="{StaticResource PanelButton}" Command="{Binding NotYetPortedCommand}" CommandParameter="장비 제어"/>
                            <Button Content="원점복귀" Style="{StaticResource PanelButton}" Command="{Binding NotYetPortedCommand}" CommandParameter="원점복귀"/>
                        </UniformGrid>
                        <Button Content="긴급 정지" Style="{StaticResource DangerButton}" Margin="3,6,3,0" Height="48" FontSize="15"
                                Command="{Binding EmergencyStopCommand}"/>
                    </StackPanel>
                </Border>

                <!-- FOUP 장착 / 웨이퍼 로드 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FOUP 장착 / 웨이퍼 로드 상태" Style="{StaticResource CardTitle}"/>
                        <Button Content="{Binding FoupMountText}" Style="{StaticResource PanelButton}" Command="{Binding ToggleFoupMountCommand}"/>
                        <UniformGrid Columns="2">
                            <Button Content="웨이퍼 로딩" Style="{StaticResource PanelButton}" Command="{Binding WaferLoadingCommand}"/>
                            <Button Content="웨이퍼 언로딩" Style="{StaticResource PanelButton}" Command="{Binding WaferUnloadingCommand}"/>
                        </UniformGrid>
                        <TextBlock Margin="3,6,0,0" Foreground="{StaticResource TextSecondary}">
                            <Run Text="현재:"/> <Run Text="{Binding WaferLoadText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 레시피 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="레시피 및 작업 설정" Style="{StaticResource CardTitle}"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" Margin="3,0,0,6">
                            <Run Text="현재 선택 레시피:"/> <Run Text="{Binding State.LastSelectedRecipe, Mode=OneWay, TargetNullValue=-}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </TextBlock>
                        <Button Content="레시피 적용" Style="{StaticResource PanelButton}" Command="{Binding NotYetPortedCommand}" CommandParameter="레시피 적용"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
