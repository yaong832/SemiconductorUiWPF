<UserControl x:Class="SemiconductorUi.Wpf.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.ReportForm: 로그 보기 / CSV 내보내기 -->
    <UserControl.Resources>
        <!-- 레벨 칩: 라디오처럼 하나만 고름 -->
        <Style x:Key="LevelChip" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1"
                                BorderBrush="{StaticResource Border}" Background="{StaticResource Surface}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="label" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border x:Name="badge" Margin="8,0,0,0" MinWidth="22" Height="20" CornerRadius="10" Padding="6,0"
                                        Background="{StaticResource SurfaceAlt}">
                                    <TextBlock x:Name="count" Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="label" Property="Foreground" Value="White"/>
                                <Setter TargetName="badge" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="count" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="0,6,6,6" Padding="16,12,16,16">
        <DockPanel>
            <!-- 도구 줄 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="폴더 열기" Style="{StaticResource SecondaryButton}" Height="34" MinWidth="92" Margin="0,0,8,0"
                            FontWeight="SemiBold" Command="{Binding OpenFolderCommand}"
                            Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="보이는 로그 CSV 저장" Style="{StaticResource PrimaryButton}" Height="34" MinWidth="160"
                            FontWeight="SemiBold" Command="{Binding ExportCommand}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource LevelChip}" VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <!-- 검색 -->
                <Grid Width="260" Height="34" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             VerticalContentAlignment="Center" Padding="8,0,28,0" BorderBrush="{StaticResource Border}"/>
                    <TextBlock Text="메시지 검색" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="✕" HorizontalAlignment="Right" Width="26" Margin="0,4,4,4" FontSize="11" Padding="0"
                            Style="{StaticResource FlatButton}" Command="{Binding ClearSearchCommand}" ToolTip="검색 지우기"/>
                </Grid>
            </DockPanel>

            <!-- 아래: 요약과 마지막 저장 경로 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasExport, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="마지막 저장: "/><Run Text="{Binding LastExportPath, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
            </DockPanel>

            <!-- 로그 표 (최신이 위) -->
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E4E8EE" BorderThickness="0"
                          Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}"
                          CanUserResizeRows="False" SelectionMode="Extended" RowHeight="28" FontSize="12.5"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          ClipboardCopyMode="ExcludeHeader">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFF8EC"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="#FDF0F1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border x:Name="cell" Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="cell" Property="Background" Value="#DCE7F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시간" Binding="{Binding TimeText}" Width="90"/>
                        <DataGridTemplateColumn Header="레벨" Width="100" SortMemberPath="Level">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="chip" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#E8EDF4">
                                        <TextBlock x:Name="text" Text="{Binding Level}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                            <Setter TargetName="chip" Property="Background" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="text" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="chip" Property="Background" Value="{StaticResource Danger}"/>
                                            <Setter TargetName="text" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="메시지" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
