<Window x:Class="SemiconductorUi.Wpf.Views.SettingsBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
        Title="설정 백업 · 복원" Width="1080" Height="680" MinWidth="880" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.SettingsBackupForm. 모달이 아니라 떠 있는 동안에도 긴급 정지를 누를 수 있다. 닫으면 숨긴다 -->
    <Window.Resources>
        <SolidColorBrush x:Key="NoticeBack" Color="#FFF6DE"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Row" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1줄: 지금 백업 -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="새로고침" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"/>
                <Button Content="폴더 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}"
                        ToolTip="고른 백업 폴더 (고르지 않았으면 백업 폴더 전체)"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="지금 백업" Style="{StaticResource PrimaryButton}" Height="32" MinWidth="100" FontWeight="SemiBold"
                        Command="{Binding BackupNowCommand}" ToolTip="로그인한 사용자만 백업할 수 있습니다"/>
                <TextBlock Text="메모" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <TextBox Width="260" Height="30" VerticalContentAlignment="Center" Padding="4,0" MaxLength="100"
                         BorderBrush="{StaticResource Border}" Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:SettingsBackupTone.Success}">
                                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:SettingsBackupTone.Danger}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- 2줄: 복원 예약 (있을 때만) -->
        <Border Grid.Row="1" Background="{StaticResource NoticeBack}" CornerRadius="4" Padding="10,6" Margin="0,10,0,0"
                Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="예약 취소" Style="{StaticResource ToolButton}" Command="{Binding CancelPendingCommand}"
                        ToolTip="관리자만 취소할 수 있습니다"/>
                <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- 3줄: 백업 목록 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Margin="0,10,0,10">
            <Grid>
                <ListView ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" BorderThickness="0"
                          Background="{StaticResource Surface}" SelectionMode="Single" ItemContainerStyle="{StaticResource Row}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                            <GridViewColumn Header="시각" DisplayMemberBinding="{Binding TimeText}" Width="150"/>
                            <GridViewColumn Header="종류" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SettingsBackupRow}">
                                        <!-- 종류 칩 (WPF 추가): 자동 회색, 수동 파랑, 복원전 주황 -->
                                        <Border x:Name="chip" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#E8EDF4">
                                            <TextBlock x:Name="text" Text="{Binding Kind}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                <Setter TargetName="chip" Property="Background" Value="#E8EFFA"/>
                                                <Setter TargetName="text" Property="Foreground" Value="{StaticResource Primary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBeforeRestore}" Value="True">
                                                <Setter TargetName="chip" Property="Background" Value="#FDEFD9"/>
                                                <Setter TargetName="text" Property="Foreground" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="사용자" DisplayMemberBinding="{Binding User}" Width="110"/>
                            <GridViewColumn Header="메모" DisplayMemberBinding="{Binding Note}" Width="300"/>
                            <GridViewColumn Header="들어 있는 항목" DisplayMemberBinding="{Binding ComponentsText}" Width="380"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Text="아직 백업이 없습니다. 프로그램을 켤 때 하루 한 번 자동으로 백업합니다." Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- 4줄: 되돌릴 항목 (확인 질문이 같은 자리에 뜬다) -->
        <Grid Grid.Row="3" MinHeight="84">
            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Padding="12,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="다음 시작 때 복원" Style="{StaticResource PrimaryButton}" Height="34" MinWidth="150"
                            FontWeight="SemiBold" VerticalAlignment="Bottom" Command="{Binding RestoreCommand}" ToolTip="관리자만 예약할 수 있습니다"/>
                    <StackPanel>
                        <TextBlock Text="고른 백업에서 되돌릴 항목 (다음에 프로그램을 켤 때 적용)" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupComponentChoice}">
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                              Margin="0,4,20,4" VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource NoticeBack}" CornerRadius="4" Padding="12,8"
                    Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="예약" Style="{StaticResource PrimaryButton}" Height="30" MinWidth="80" Margin="6,0,0,0"
                                Command="{Binding ConfirmRestoreCommand}"/>
                        <Button Content="취소" Style="{StaticResource SecondaryButton}" Height="30" MinWidth="80" Margin="6,0,0,0"
                                Command="{Binding CancelConfirmCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 5줄: 안내 -->
        <TextBlock Grid.Row="4" Text="{Binding Footnote}" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
