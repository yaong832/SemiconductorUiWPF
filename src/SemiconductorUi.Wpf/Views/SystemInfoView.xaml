<UserControl x:Class="SemiconductorUi.Wpf.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
             FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Form1.ShowSystemInfoSummary ("System Information" 메시지 상자) → 같은 창 안 화면 -->
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10,14,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:InfoTone.Good}">
                    <Setter Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:InfoTone.Warn}">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:InfoTone.Bad}">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 이름 / 값 한 줄 -->
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ValueText}" ToolTip="{Binding Value}"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 + 복사 -->
        <DockPanel Margin="0,0,10,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Style="{StaticResource ToolButton}" Content="요약 복사" Command="{Binding CopySummaryCommand}"
                        ToolTip="원본 System Information 창의 글자(App Version, OS, .NET, EtherCAT, Login, Process)를 복사합니다"/>
                <Button Style="{StaticResource ToolButton}" Content="전체 복사" Command="{Binding CopyAllCommand}"
                        ToolTip="요약과 아래 항목, 기록 위치를 모두 복사합니다 (문의할 때 붙여 넣기)"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="시스템 정보" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="보이는 동안 1초마다 고칩니다." Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="프로그램" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding ProgramRows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="장비" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding EquipmentRows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                    <TextBlock Text="운전" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding OperationRows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                </StackPanel>
            </Border>

            <!-- 원본 메시지 상자 글자 그대로 -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="System Information (원본 요약)" Style="{StaticResource SectionTitle}"/>
                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding SummaryText}" FontFamily="Consolas, Malgun Gothic" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 기록 위치 -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="기록 위치" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding FolderRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" FontFamily="Consolas, Malgun Gothic"/>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="열기" Height="26" MinWidth="56"
                                            Padding="10,0" Margin="8,0,0,0" Command="{Binding OpenCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
