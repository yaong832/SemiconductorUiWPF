<UserControl x:Class="SemiconductorUi.Wpf.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.TransferForm (대기 중 이송 작업 목록, Auto Plan / Clear) + 경로·TM 상태 카드 (WPF 추가) -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="SourceBack" Color="#FEF5E4"/>
        <SolidColorBrush x:Key="TargetBack" Color="#EAF0FB"/>
        <Style x:Key="ListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueueRow" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TargetBack}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 경로: FOUP A → Chamber A → B/C → FOUP B (진행 중 이송의 출발 주황, 도착 파랑) -->
        <ItemsControl ItemsSource="{Binding Units}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,0" Padding="10,8" CornerRadius="6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSource}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SourceBack}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource TargetBack}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSource}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="{StaticResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="{StaticResource Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="White" FontSize="10.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="출발"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                        <Setter Property="Text" Value="도착"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SmallLabel}"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Primary}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWafer}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="2" Text="{Binding Secondary}" Foreground="{StaticResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- TM 상태 + 진행 중 작업 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    Background="{StaticResource SurfaceAlt}">
                <StackPanel>
                    <TextBlock Text="TM 상태" Style="{StaticResource SmallLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTmBusy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding TmStatusText}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TmPhaseText}" Foreground="{StaticResource TextSecondary}" Margin="18,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,8,0" Padding="12,10" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    Background="{StaticResource SurfaceAlt}">
                <StackPanel>
                    <TextBlock Text="진행 중 이송" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="{Binding CurrentRouteText}" FontSize="15" FontWeight="Bold" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CurrentWaferText}" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding CurrentRetryText}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 대기열 제목 + 버튼 (원본 Auto Plan / Clear) -->
        <DockPanel Grid.Row="2" Margin="0,14,8,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Content="이송 계획 (데모)" Command="{Binding AutoPlanCommand}"
                        ToolTip="원본 Auto Plan: TM이 대기 중이고 FOUP에 웨이퍼가 있으면 계획을 로그에 남깁니다"/>
                <Button Style="{StaticResource ToolButton}" Content="목록 복사" Command="{Binding CopyQueueCommand}"
                        ToolTip="대기열을 원본 이송 창의 글자 그대로 클립보드에 복사합니다"/>
                <Button Style="{StaticResource ToolButton}" Content="큐 비우기" Command="{Binding ClearQueueCommand}"
                        ToolTip="{Binding ClearQueueToolTip}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding QueueHeaderText}" FontSize="13.5" FontWeight="Bold"/>
                <TextBlock Text="{Binding LastActionText}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 대기열 (원본 ListView "대기 중 이송 작업 (출발 → 도착 · 웨이퍼 ID)") -->
        <Border Grid.Row="3" Margin="0,0,8,0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ListView ItemsSource="{Binding QueueRows}" BorderThickness="0" Background="{StaticResource Surface}"
                          ItemContainerStyle="{StaticResource QueueRow}" SelectionMode="Single">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                            <GridViewColumn Header="순서" Width="80" DisplayMemberBinding="{Binding OrderText}"/>
                            <GridViewColumn Header="출발" Width="170" DisplayMemberBinding="{Binding From}"/>
                            <GridViewColumn Header="" Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="→" Foreground="{StaticResource TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="도착" Width="170" DisplayMemberBinding="{Binding To}"/>
                            <GridViewColumn Header="웨이퍼 ID" Width="100" DisplayMemberBinding="{Binding WaferText}"/>
                            <GridViewColumn Header="재시도" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RetryText}" Foreground="{StaticResource Warning}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                           Text="대기 중인 이송 작업이 없습니다.&#10;공정을 시작하면 TM 예약(FOUP A → Chamber A 등)이 여기에 쌓입니다.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasQueueRows}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
