<UserControl x:Class="SemiconductorUi.Wpf.Views.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SemiconductorUi.Wpf.Controls"
             FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.TrendForm (4777c6c): Chamber A/B/C × 온도·압력, PV 실선 / SV 점선 -->
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ChartFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="16,12,16,16">
        <DockPanel>
            <!-- 도구 줄: 표시 구간, 기록 상태 / 범례, 지우기 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Line X1="0" Y1="0" X2="22" Y2="0" Stroke="{Binding PvBrush}" StrokeThickness="2.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="PV (현재값)" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Line X1="0" Y1="0" X2="22" Y2="0" Stroke="{Binding SvBrush}" StrokeThickness="2" StrokeDashArray="2,1.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="SV (레시피 설정값)" VerticalAlignment="Center"/>
                    <Button Content="지우기" Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}"
                            ToolTip="지금까지 기록한 추이를 모두 지웁니다."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="표시 구간" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Label"
                              Width="120" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <!-- 3행(Chamber A/B/C) × 2열(온도, 압력) -->
            <ItemsControl ItemsSource="{Binding Chambers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ChartFrame}">
                                <ctl:TrendChart Title="{Binding Temperature.Title}" ValueFormat="{Binding Temperature.ValueFormat}"
                                                Series="{Binding Temperature.Series}"
                                                TimeFrom="{Binding Temperature.TimeFrom}" TimeTo="{Binding Temperature.TimeTo}"
                                                EmptyText="{Binding Temperature.EmptyText}"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ChartFrame}">
                                <ctl:TrendChart Title="{Binding Pressure.Title}" ValueFormat="{Binding Pressure.ValueFormat}"
                                                Series="{Binding Pressure.Series}"
                                                TimeFrom="{Binding Pressure.TimeFrom}" TimeTo="{Binding Pressure.TimeTo}"
                                                EmptyText="{Binding Pressure.EmptyText}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
