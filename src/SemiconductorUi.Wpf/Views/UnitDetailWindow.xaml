<Window x:Class="SemiconductorUi.Wpf.Views.UnitDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="520" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="12">
    <!-- 원본 Forms.UnitDetailForm + Controls.UnitDetailPopup. 화면 표시만 한다. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Primary}" BorderThickness="2">
        <StackPanel>
            <!-- 머리줄: 램프, 이름, 상태 칩, 실시간 -->
            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    Height="38" Padding="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding LampBrush}" Stroke="#46000000" StrokeThickness="1"/>
                    <TextBlock Text="{Binding Title}" Margin="8,0,10,0" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border CornerRadius="10" Height="20" Padding="9,0" Background="{Binding PillBackground}"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Foreground="{Binding PillForeground}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Live, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Success}"/>
                        <TextBlock Text="실시간" Margin="4,0,0,0" Style="{StaticResource Small}" Foreground="{StaticResource Success}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 본문: 왼쪽 정보, 오른쪽 환경 표 또는 슬롯 -->
            <Grid Margin="14,14,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="47*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="53*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ItemsControl ItemsSource="{Binding Info}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="21">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="11" Height="22" Padding="9,0" Margin="0,0,6,0" BorderThickness="1"
                                        Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Small}" Foreground="{Binding Foreground}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 환경 표 (원본 DrawEnvTable) -->
                <StackPanel Grid.Column="2" Visibility="{Binding HasEnv, Converter={StaticResource BoolToVis}}">
                    <Grid Height="21">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="30*"/>
                            <ColumnDefinition Width="18*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="현재값 PV" Style="{StaticResource Small}" Foreground="#1C7A49"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="2" Text="설정값 SV" Style="{StaticResource Small}" Foreground="{StaticResource Primary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"/>
                    <ItemsControl ItemsSource="{Binding EnvRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="21" BorderBrush="{StaticResource SurfaceAlt}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22*"/>
                                            <ColumnDefinition Width="30*"/>
                                            <ColumnDefinition Width="30*"/>
                                            <ColumnDefinition Width="18*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Pv}" Foreground="{Binding PvBrush}" FontFamily="Consolas"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Sv}" Foreground="{Binding SvBrush}" FontFamily="Consolas"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- FOUP 슬롯 (원본 DrawSlots) -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Slots}"
                              Visibility="{Binding HasSlots, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="24" Margin="0,0,0,4" CornerRadius="4" BorderThickness="1"
                                    Background="{Binding Background}" BorderBrush="{Binding BorderBrush}">
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding LampBrush}"/>
                                    <TextBlock Text="{Binding Text}" Margin="7,0,0,0" Foreground="{Binding Foreground}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasWafer}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- 진행률 -->
            <StackPanel Margin="14,7,14,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProgressText}" Height="21" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Height="8" Margin="0,2,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{StaticResource Primary}" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"/>
            </StackPanel>
            <Border Height="14"/>
        </StackPanel>
    </Border>
</Window>
