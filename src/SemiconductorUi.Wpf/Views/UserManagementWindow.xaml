<Window x:Class="SemiconductorUi.Wpf.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사용자 관리" Width="720" Height="600" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.UserManagementForm -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 버튼: 왼쪽 추가/수정/삭제, 오른쪽 닫기 -->
        <Border DockPanel.Dock="Bottom" Height="72" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Content="닫기" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding CloseCommand}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="추가" Style="{StaticResource PrimaryButton}" Width="110" Height="44" FontWeight="Bold" Margin="0,0,10,0"
                            Command="{Binding AddCommand}"/>
                    <Button Content="수정" Style="{StaticResource ActionButton}" Command="{Binding UpdateCommand}"/>
                    <Button Content="삭제" Style="{StaticResource ActionButton}" Command="{Binding DeleteCommand}"/>
                    <Button Content="새 사용자" Style="{StaticResource ActionButton}" Command="{Binding NewCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="20,16,20,0">
            <TextBlock Text="사용자 관리" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- 사용자 목록 -->
            <ListView ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" Height="250"
                      BorderBrush="{StaticResource Border}" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="사용자명" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                        <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,0" Background="#E3ECFB"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="나" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="역할" Width="150" DisplayMemberBinding="{Binding Role}"/>
                        <GridViewColumn Header="생성일" Width="250" DisplayMemberBinding="{Binding CreatedText}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 입력 필드 -->
            <Border Margin="0,14,0,0" Padding="14,10,14,12" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="새 사용자"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="사용자 정보 수정"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="사용자명" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Height="28" VerticalContentAlignment="Center" BorderBrush="{StaticResource Border}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUsername}"/>
                        <TextBlock Grid.Column="3" Text="비밀번호" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PasswordInput" Grid.Column="4" Height="28" VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource Border}"/>
                        <TextBlock Grid.Row="1" Text="역할" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Height="28" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding PasswordHint}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
