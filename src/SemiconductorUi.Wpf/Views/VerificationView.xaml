<UserControl x:Class="SemiconductorUi.Wpf.Views.VerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:proc="clr-namespace:SemiconductorUi.Process;assembly=SemiconductorUi.Core"
             FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.VerificationForm (체크 항목 / 결과(OK/FAIL), FAIL 줄은 붉게) + Form1.RunVerificationChecks -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="PassBack" Color="#E7F5EC"/>
        <SolidColorBrush x:Key="FailBack" Color="#FDECED"/>
        <SolidColorBrush x:Key="NoDataBack" Color="#F2F5F9"/>
        <Style x:Key="ListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckRow" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static proc:InterlockCheckState.Fail}">
                    <Setter Property="Background" Value="{StaticResource FailBack}"/>
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static proc:InterlockCheckState.NoData}">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 결과 알약: OK 초록 / FAIL 빨강 / 데이터 없음 회색 -->
        <Style x:Key="ResultPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource PassBack}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static proc:InterlockCheckState.Fail}">
                    <Setter Property="Background" Value="{StaticResource Danger}"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static proc:InterlockCheckState.NoData}">
                    <Setter Property="Background" Value="{StaticResource NoDataBack}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 요약 (원본 창 제목 "Verification - …") -->
        <Border CornerRadius="6" Padding="14,10" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource FailBack}"/>
                    <Setter Property="BorderBrush" Value="#F3C2C6"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllPassed}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PassBack}"/>
                            <Setter Property="BorderBrush" Value="#B9E0C8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="14" Height="14" VerticalAlignment="Top" Margin="0,4,12,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Danger}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllPassed}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding HeadlineText}" ToolTip="{Binding SummaryText}"/>
                    <TextBlock Text="{Binding ReasonsText}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding CountsText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CheckedAtText}" Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="다시 검사" Command="{Binding RecheckCommand}"
                            Height="32" MinWidth="88" ToolTip="지금 다시 판정하고 결과를 로그에 남깁니다"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 알람 리셋으로 경고를 숨긴 상태 (원본 VerificationAlarmDismissed) -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" Background="#FEF5E4"
                Visibility="{Binding IsWarningDismissed, Converter={StaticResource BoolToVisibility}}">
            <TextBlock TextWrapping="Wrap" Foreground="#8A5A0B"
                       Text="알람 리셋으로 검증 경고를 숨겼습니다. 상단 알람 표시에는 다시 띄우지 않으며, 인터락이 한 번 통과하면 다시 알립니다."/>
        </Border>

        <!-- 체크 목록 -->
        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
            <ListView ItemsSource="{Binding Rows}" BorderThickness="0" Background="{StaticResource Surface}"
                      ItemContainerStyle="{StaticResource CheckRow}" SelectionMode="Single">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                        <GridViewColumn Header="체크 항목 (무엇을 점검하는가)" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="결과(OK/FAIL)" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ResultPill}">
                                        <TextBlock Text="{Binding ResultText}" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="현재 값 / 기준" Width="460">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,8,0,0" Text="{Binding CriteriaText}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
    </Grid>
</UserControl>
