<Window x:Class="SemiconductorUi.Wpf.Views.WaferCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="웨이퍼 로딩 수 설정" Width="320" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}" FocusManager.FocusedElement="{Binding ElementName=CountBox}">
    <!-- 원본 FoupManager.PromptForWaferCount -->
    <StackPanel Margin="20">
        <TextBlock x:Name="RangeText" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="−" Style="{StaticResource SecondaryButton}" Width="32" Click="OnMinus"/>
            <TextBox x:Name="CountBox" Width="64" Margin="6,0" Padding="6,4" TextAlignment="Center" VerticalContentAlignment="Center"/>
            <Button Content="+" Style="{StaticResource SecondaryButton}" Width="32" Click="OnPlus"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,0,0,10" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Style="{StaticResource PrimaryButton}" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
