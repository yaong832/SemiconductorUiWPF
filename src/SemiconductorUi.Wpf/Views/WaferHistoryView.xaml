<UserControl x:Class="SemiconductorUi.Wpf.Views.WaferHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SemiconductorUi.Wpf.ViewModels"
             x:Name="Root"
             FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextPrimary}">
    <!-- 원본 Forms.WaferHistoryForm: 웨이퍼마다 챔버별 투입·공정·반출 시각과 결과 (읽기 전용) -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="RunningRowBack" Color="#E8F1FF"/>
        <SolidColorBrush x:Key="AbortedRowBack" Color="#FFECEC"/>
        <SolidColorBrush x:Key="Track" Color="#E4E8EE"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RightHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ListHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="CenterHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ListHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- 진행 중은 파란 바탕, 중단은 붉은 바탕 (원본 RunningBack/AbortedBack) -->
        <Style x:Key="Row" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RunningRowBack}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAborted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AbortedRowBack}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 챔버 칸: 레시피보다 오래 걸렸으면 주황, 공정 중이면 파랑, 중단이면 빨강 (WPF 추가) -->
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Static vm:WaferStepState.Over}">
                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:WaferStepState.Processing}">
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:WaferStepState.Waiting}">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                </Trigger>
                <Trigger Property="Tag" Value="{x:Static vm:WaferStepState.Aborted}">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="0,6,6,6" Padding="16,12,16,16">
        <DockPanel>
            <!-- 도구 줄: 기간, 결과, 검색 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로고침" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"/>
                    <Button Content="폴더 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenFolderCommand}"/>
                    <Button Content="별도 창으로 열기" Style="{StaticResource ToolButton}" Command="{Binding OpenWindowCommand}"
                            ToolTip="운전 화면을 보면서 함께 볼 수 있게 따로 띄웁니다"
                            Visibility="{Binding ShowOpenWindowButton, ElementName=Root, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="110" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding Periods}"
                              SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Name"/>
                    <TextBlock Text="결과" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox Width="90" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedResult}"/>
                    <!-- 검색 (WPF 추가) -->
                    <Grid Width="230" Height="34" Margin="16,0,0,0">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 VerticalContentAlignment="Center" Padding="8,0,28,0" BorderBrush="{StaticResource Border}"/>
                        <TextBlock Text="작업·#웨이퍼·레시피·비고 검색" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="✕" HorizontalAlignment="Right" Width="26" Margin="0,4,4,4" FontSize="11" Padding="0"
                                Style="{StaticResource FlatButton}" Command="{Binding ClearSearchCommand}" ToolTip="검색 지우기"/>
                    </Grid>
                    <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Footnote}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                       Margin="0,10,0,0" TextWrapping="Wrap"/>

            <!-- 선택한 웨이퍼: 챔버별 카드 (원본은 글자 상자, WPF는 카드와 실제/레시피 막대) -->
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="14,10" CornerRadius="4" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1" MinHeight="150">
                <Grid>
                    <TextBlock Text="웨이퍼를 고르면 챔버마다 투입·공정·반출 시각이 여기에 나옵니다." Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DetailTitle}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding DetailSubtitle}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailSubtitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DetailSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Margin="0,0,10,0" Padding="12,8" CornerRadius="4" Background="{StaticResource Surface}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <Border x:Name="badge" DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Background="#E8EFFA"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="badgeText" Text="{Binding StateText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource Primary}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                            </DockPanel>
                                            <Grid x:Name="times" Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="투입" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding InText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="공정 시작" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding StartText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="공정 끝" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding EndText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="반출" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding OutText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- 실제 / 레시피 공정 시간 막대 (WPF 추가) -->
                                            <DockPanel x:Name="bar" Grid.Row="2" Margin="0,8,0,0">
                                                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12">
                                                    <Run Text="실제"/> <Run Text="{Binding ActualText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="/ 레시피" Foreground="{StaticResource TextSecondary}"/>
                                                    <Run Text="{Binding SetText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                                                </TextBlock>
                                                <Border Height="6" CornerRadius="3" Background="{StaticResource Track}" VerticalAlignment="Center">
                                                    <Border x:Name="fill" CornerRadius="3" Background="{StaticResource Success}" HorizontalAlignment="Stretch">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Ratio}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WaferStepState.NotVisited}">
                                            <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                                            <Setter TargetName="times" Property="Visibility" Value="Hidden"/>
                                            <Setter TargetName="bar" Property="Visibility" Value="Hidden"/>
                                            <Setter TargetName="badge" Property="Background" Value="{StaticResource Track}"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WaferStepState.Done}">
                                            <Setter TargetName="badge" Property="Background" Value="#E3F4EA"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WaferStepState.Over}">
                                            <Setter TargetName="badge" Property="Background" Value="#FFF1DC"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="fill" Property="Background" Value="{StaticResource Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WaferStepState.Processing}">
                                            <Setter TargetName="fill" Property="Background" Value="{StaticResource Primary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WaferStepState.Aborted}">
                                            <Setter TargetName="badge" Property="Background" Value="#FFE4E4"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource Danger}"/>
                                            <Setter TargetName="fill" Property="Background" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 완료·중단 수와 평균 (WPF 추가) -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6"/>

            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0"
                              Background="{StaticResource Surface}" FontSize="12.5"
                              SelectionMode="Single" ItemContainerStyle="{StaticResource Row}"
                              VirtualizingPanel.IsVirtualizing="True">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                                <GridViewColumn Header="끝난 시각" Width="148">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="t" Text="{Binding EndText}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource Primary}"/>
                                                    <Setter TargetName="t" Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="작업" DisplayMemberBinding="{Binding Run}" Width="122"/>
                                <GridViewColumn Header="웨이퍼" Width="62" HeaderContainerStyle="{StaticResource CenterHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WaferText}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="레시피" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Recipe}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Recipe}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="결과" Width="74" HeaderContainerStyle="{StaticResource CenterHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="b" CornerRadius="9" Padding="8,1" HorizontalAlignment="Center" Background="#E3F4EA">
                                                <TextBlock x:Name="t" Text="{Binding ResultText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#D6E6FF"/>
                                                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAborted}" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#FFD9D9"/>
                                                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="경로" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Route}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Route}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="A 공정" Width="118" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ACell}" Tag="{Binding AState}" Style="{StaticResource StepText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="B 공정" Width="118" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BCell}" Tag="{Binding BState}" Style="{StaticResource StepText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="C 공정" Width="118" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CCell}" Tag="{Binding CState}" Style="{StaticResource StepText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="총 시간" Width="84" HeaderContainerStyle="{StaticResource RightHeader}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="비고" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Text="이 기간에 남은 웨이퍼 이력이 없습니다." Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
